# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Supabase: Project Settings > API Keys > secret (or service_role).
# Publishing, the photographer portal and the Facebook connection need it.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (aistudio.google.com > Get API key). Free tier is fine for
# testing. Without it, AI picks and captions show sample results.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Meta for Developers app (developers.facebook.com > My Apps).
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v23.0

# Optional. If set, /api/cron/publish needs "Authorization: Bearer <value>".
# CRON_SECRET=
